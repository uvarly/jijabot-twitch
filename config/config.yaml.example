database:
  path: "your_database_file_path"

phrasebook:
  path: "./config/phrasebook.yaml"
  required_entries:
    - hi.internal_error
    - hi.greeting
    - hi.greeting_streamer
    - balance.internal_error
    - balance.success
    - daily.internal_error
    - daily.already_redeemed
    - daily.success
    - bet.internal_error
    - bet.invalid_amount_missing_args
    - bet.invalid_amount_not_integer
    - bet.invalid_amount_less_than_zero
    - bet.insufficient_funds
    - bet.daily_limit_reached
    - bet.win
    - bet.lose
    - grant.internal_error
    - grant.permission_denied
    - grant.missing_args
    - grant.invalid_amount_not_integer
    - grant.invalid_amount_less_than_zero
    - grant.target_user_not_found
    - grant.success
    - duel.internal_error
    - duel.missing_args
    - duel.invalid_amount_not_integer
    - duel.invalid_amount_less_than_zero
    - duel.target_user_not_found
    - duel.cannot_target_self
    - duel.user_has_pending_duel
    - duel.target_has_pending_duel
    - duel.insufficient_funds
    - duel.daily_limit_reached
    - duel.success
    - duel_accept.internal_error
    - duel_accept.no_incoming_duel
    - duel_accept.insufficient_funds
    - duel_accept.success_with_winner
    - duel_accept.success_with_draw
    - duel_decline.internal_error
    - duel_decline.no_incoming_duel
    - duel_decline.success
    - duel_cancel.internal_error
    - duel_cancel.no_outgoing_duel
    - duel_cancel.success
    - arena.internal_error
    - arena.success
    - arena_top.internal_error
    - arena_top.no_top_user_yet
    - arena_top.success
    - arena_stats.internal_error
    - arena_stats.success
    - arena_rank.internal_error
    - arena_rank.success

twitch_bot:
  username: "your_twitch_username"
  channel: "your_twitch_channel_name"
  client_id: "your_app_client_id"
  client_secret: "you_app_client_secret"

oauth:
  token_file_path: "your_token_file_path"

jija_bot:
  streamer_twitch_user_id: "42754848"
  ranks:
    - name: "Чмоня"
      min_rating: 0
    - name: "Жижик"
      min_rating: 1500
    - name: "Воин Жижи"
      min_rating: 2000
  commands:
    daily:
      jija_coin_amount: 10
      reset_hour_utc: 12
    bet:
      base_probability: 0.45
      payout_multiple: 2.0
      daily_limit: 5
      reset_hour_utc: 12
    duel:
      daily_limit: 20
      reset_hour_utc: 12
      expiry_duration: 5m
      mmr:
        elo:
          default_rating: 1000
          k_factor: 32
