hi:
  internal_error:
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  greeting: # required params: {{.User}}
    - text: "Привет, @{{.User}}!"
      weight: 2.0
    - text: "Здарова, @{{.User}}!"
      weight: 1.0
  greeting_streamer:
    - text: "Приветствую, Владыка!"
      weight: 1.0

balance:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  success: # required params: {{.User}}, {{.Balance}}
    - text: "@{{.User}}, твой баланс: {{.Balance}} жижа-коинов."
      weight: 1.0

daily:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  already_redeemed: # required params: {{.User}}, {{.ResetHour}}
    - text: "@{{.User}}, на сегодня жижа-коины уже получены! Заходи после {{.ResetHour}} UTC+3."
      weight: 1.0
  success: # required params: {{.User}}, {{.Amount}}, {{.Balance}}
    - text: "@{{.User}}, получено +{{.Amount}} жижа-коинов! Твой баланс: {{.Balance}}."
      weight: 1.0

bet:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  invalid_amount_missing_args: # required params: {{.User}}
    - text: "@{{.User}}, укажи ставку. Пример: !bet 10."
      weight: 1.0
  invalid_amount_not_integer: # required params: {{.User}}
    - text: "@{{.User}}, ставка должна быть числом. Пример: !bet 10."
      weight: 1.0
  invalid_amount_less_than_zero: # required params: {{.User}}
    - text: "@{{.User}}, ставка должна быть больше нуля. Пример: !bet 10."
      weight: 1.0
  insufficient_funds: # required params: {{.User}}
    - text: "@{{.User}}, у тебя недостаточно жижа-коинов для такой ставки."
      weight: 1.0
  daily_limit_reached: # required params: {{.User}}
    - text: "@{{.User}}, на сегодня лимит ставок исчерпан."
      weight: 1.0
  win: # required params: {{.User}}, {{.Payout}}, {{.NewBalance}}
    - text: "@{{.User}}, поздравляю! Твой выигрыш: {{.Payout}} жижа-коинов! Баланс: {{.NewBalance}}"
      weight: 1.0
  lose: # required params: {{.User}}, {{.Payout}}, {{.NewBalance}}
    - text: "@{{.User}}, не в этот раз. -{{.Payout}} жижа-коинов. Баланс: {{.NewBalance}}"
      weight: 1.0
    - text: "@{{.User}}, {{.Payout}} жижа-коинов улетели в трубу. Баланс: {{.NewBalance}}"
      weight: 1.0

grant:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  permission_denied: # required params: {{.User}}
    - text: "@{{.User}}, эта команда доступна только стримеру."
      weight: 1.0
  missing_args: # required params: {{.User}}
    - text: "@{{.User}}, укажи пользователя и сумму. Пример: !grant @user 10."
      weight: 1.0
  invalid_amount_not_integer: # required params: {{.User}}
    - text: "@{{.User}}, сумма должна быть числом. Пример: !grant @user 10."
      weight: 1.0
  invalid_amount_less_than_zero: # required params: {{.User}}
    - text: "@{{.User}}, сумма должна быть больше нуля. Пример: !grant @user 10."
      weight: 1.0
  target_user_not_found: # required params: {{.User}}
    - text: "@{{.User}}, пользователь не найден."
      weight: 1.0
  success: # required params: {{.User}}, {{.TargetUser}}, {{.Amount}}, {{.NewBalance}}
    - text: "@{{.User}} начислил {{.Amount}} жижа-коинов пользователю @{{.TargetUser}}. Баланс: {{.NewBalance}}."
      weight: 1.0

arena:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  success:
    - text: "⚔️ ARENA JIJA WARRIORS ⚔️ Место, где зрители превращаются в настоящих воинов! Вступай в бой и докажи всем, кто здесь главный — победителей ждёт слава! Готов рискнуть?"
      weight: 1.0

arena_top:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  no_top_user_yet: # required params: {{.User}}
    - text: "@{{.User}}, никто ещё не занял первое место."
      weight: 1.0
  success: # required params: {{.User}}, {{.RatingValue}}, {{.WinCount}}
    - text: "@{{.User}} — {{.RatingValue}} MMR — {{.WinCount}} побед."
      weight: 1.0

arena_stats:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  success: # required params: {{.User}}, {{.WinCount}}, {{.LossCount}}, {{.DrawCount}}, {{.WinRatePercent}}
    - text: "⚔️ @{{.User}} ⚔️ W: {{.WinCount}} | L: {{.LossCount}} | D: {{.DrawCount}} | WR: {{.WinRatePercent}}%"
      weight: 1.0

arena_rank:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  success: # required params: {{.User}}, {{.Rank}}, {{.RatingValue}}
    - text: "@{{.User}}, твой ранг: {{.Rank}} {{.RatingValue}} MMR"
      weight: 1.0

duel:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  missing_args: # required params: {{.User}}
    - text: "@{{.User}}, укажи пользователя и ставку. Пример: !duel @user 10."
      weight: 1.0
  invalid_amount_not_integer: # required params: {{.User}}
    - text: "@{{.User}}, ставка должна быть числом. Пример: !duel @user 10."
      weight: 1.0
  invalid_amount_less_than_zero: # required params: {{.User}}
    - text: "@{{.User}}, ставка должна быть больше нуля. Пример: !duel @user 10."
      weight: 1.0
  target_user_not_found: # required params: {{.User}}
    - text: "@{{.User}}, пользователь не найден."
      weight: 1.0
  cannot_target_self: # required params: {{.User}}
    - text: "@{{.User}}, нельзя вызвать самого себя на дуэль."
      weight: 1.0
  user_has_pending_duel: # required params: {{.User}}
    - text: "@{{.User}}, у тебя уже есть дуэль. Используй !duel_cancel, чтобы отменить ее."
      weight: 1.0
  target_has_pending_duel: # required params: {{.User}}
    - text: "@{{.User}}, у пользователя уже есть дуэль."
      weight: 1.0
  insufficient_funds: # required params: {{.User}}
    - text: "@{{.User}}, у тебя недостаточно жижа-коинов для такой ставки."
      weight: 1.0
  daily_limit_reached: # required params: {{.User}}
    - text: "@{{.User}}, на сегодня лимит дуэлей исчерпан."
      weight: 1.0
  success: # required params: {{.ChallengerUser}}, {{.OpponentUser}}, {{.Amount}}
    - text: "@{{.ChallengerUser}} вызвал {{.OpponentUser}} на дуэль. Ставка: {{.Amount}} жижа-коинов."
      weight: 1.0

duel_accept:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  no_incoming_duel: # required params: {{.User}}
    - text: "@{{.User}}, у тебя нет входящих дуэлей."
      weight: 1.0
  insufficient_funds: # required params: {{.User}}
    - text: "@{{.User}}, у тебя недостаточно жижа-коинов для встречной ставки."
      weight: 1.0
  success_with_winner: # required params: {{.ChallengerUser}}, {{.OpponentUser}}, {{.ChallengerRoll}}, {{.OpponentRoll}}, {{.Winner}}
    - text: "@{{.OpponentUser}} принял вызов от @{{.ChallengerUser}}. Бросок @{{.ChallengerUser}}: {{.ChallengerRoll}}, @{{.OpponentUser}}: {{.OpponentRoll}}. Победитель: {{.Winner}}."
      weight: 1.0
  success_with_draw: # required params: {{.ChallengerUser}}, {{.OpponentUser}}, {{.ChallengerRoll}}, {{.OpponentRoll}}
    - text: "@{{.OpponentUser}} принял вызов от @{{.ChallengerUser}}. Бросок @{{.ChallengerUser}}: {{.ChallengerRoll}}, @{{.OpponentUser}}: {{.OpponentRoll}}. Ничья."
      weight: 1.0

duel_decline:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  no_incoming_duel: # required params: {{.User}}
    - text: "@{{.User}}, у тебя нет входящих дуэлей."
      weight: 1.0
  success: # required params: {{.ChallengerUser}}, {{.OpponentUser}}
    - text: "@{{.OpponentUser}} отклонил вызов от @{{.ChallengerUser}}."
      weight: 1.0

duel_cancel:
  internal_error: # required params: {{.User}}
    - text: "@{{.User}}, что-то пошло не так, попробуй позже."
      weight: 1.0
  no_outgoing_duel: # required params: {{.User}}
    - text: "@{{.User}}, у тебя нет исходящих дуэлей."
      weight: 1.0
  success: # required params: {{.ChallengerUser}}, {{.OpponentUser}}
    - text: "@{{.ChallengerUser}} отменил дуэль с @{{.OpponentUser}}."
      weight: 1.0
